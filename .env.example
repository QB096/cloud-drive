# ---- RainS3 对象存储连接信息 ----
S3_ENDPOINT=https://cn-nb1.rains3.com
S3_REGION=cn-nb1
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_BUCKET=your-bucket

# ---- 应用 ----
PORT=8080
APP_NAME=我的云盘

# 访问口令：留空 = 不开启登录（仅建议本机使用）
APP_PASSWORD=

# 会话签名密钥（留空则每次启动随机生成）
SESSION_SECRET=

# 分享链接默认有效期（秒）
SHARE_EXPIRES=604800
